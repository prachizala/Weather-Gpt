# WeatherGPT Environment Configuration

# Application
APP_NAME="WeatherGPT API"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
DEBUG=true

# Cache Settings
CACHE_DEFAULT_TTL_SECONDS=300

# Open-Meteo Configuration
# WARNING: Free tier is strictly for non-commercial use.
# For commercial use, set OPEN_METEO_COMMERCIAL=true and provide OPEN_METEO_API_KEY.
OPEN_METEO_COMMERCIAL=false
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL="https://api.open-meteo.com"
OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com"
OPEN_METEO_GEOCODING_URL="https://geocoding-api.open-meteo.com"
OPEN_METEO_AIR_QUALITY_URL="https://air-quality-api.open-meteo.com"

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=
LLM_MODEL_MAIN="google/gemini-2.5-flash"
LLM_MODEL_FAST="google/gemini-2.5-flash-lite"
LLM_MODEL_FALLBACK=
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
APP_URL=
APP_TITLE="WeatherGPT"
